import pandas as pd

def predict_car_price(car_data):
    
    # Convert input data into a DataFrame
    input_df = pd.DataFrame([car_data])
    
    # Apply preprocessing
    processed_data = loaded_preprocessor.transform(input_df)
    
    # Make prediction
    prediction = loaded_model.predict(processed_data)
    
    # Return predicted price
    return prediction[0]





