from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
import numpy as np

# --------------------------------------------------
# 1. Identify extreme-mileage records in training data
# --------------------------------------------------

training_extreme_mask = X_train["kmDriven"] > 500000

print("Extreme-mileage records in training set:",
      training_extreme_mask.sum())

# Keep only records with kmDriven <= 500,000
X_train_clean = X_train.loc[~training_extreme_mask].copy()
y_train_clean = y_train.loc[~training_extreme_mask].copy()

print("Original training records:", len(X_train))
print("Cleaned training records:", len(X_train_clean))
print("Records removed from training:", len(X_train) - len(X_train_clean))


# --------------------------------------------------
# 2. Create a NEW preprocessing pipeline
# --------------------------------------------------

clean_preprocessor = ColumnTransformer(
    transformers=[
        (
            "categorical",
            OneHotEncoder(handle_unknown="ignore"),
            categorical_columns
        )
    ],
    remainder="passthrough"
)


# --------------------------------------------------
# 3. Fit preprocessing ONLY on cleaned training data
# --------------------------------------------------

X_train_clean_processed = clean_preprocessor.fit_transform(
    X_train_clean
)

X_test_clean_processed = clean_preprocessor.transform(
    X_test
)

print("\nCleaned training processed shape:",
      X_train_clean_processed.shape)

print("Test processed shape:",
      X_test_clean_processed.shape)


# --------------------------------------------------
# 4. Train a second Random Forest model
# --------------------------------------------------

clean_model = RandomForestRegressor(
    n_estimators=100,
    random_state=42,
    n_jobs=-1
)

print("\nTraining cleaned-data Random Forest...")

clean_model.fit(
    X_train_clean_processed,
    y_train_clean
)

print("Cleaned-data model training completed.")


# --------------------------------------------------
# 5. Generate predictions on the SAME test set
# --------------------------------------------------

clean_y_pred = clean_model.predict(
    X_test_clean_processed
)


# --------------------------------------------------
# 6. Evaluate cleaned model
# --------------------------------------------------

clean_mae = mean_absolute_error(
    y_test,
    clean_y_pred
)

clean_rmse = np.sqrt(
    mean_squared_error(
        y_test,
        clean_y_pred
    )
)

clean_r2 = r2_score(
    y_test,
    clean_y_pred
)


# --------------------------------------------------
# 7. Display results
# --------------------------------------------------

print("\nCleaned Model Evaluation Results")
print("--------------------------------")
print("MAE :", clean_mae)
print("RMSE:", clean_rmse)
print("R²  :", clean_r2)





# Store baseline and cleaned model metrics

comparison = {
    "Metric": ["MAE", "RMSE", "R²"],
    "Baseline Model": [
        mae,
        rmse,
        r2
    ],
    "Cleaned Model": [
        clean_mae,
        clean_rmse,
        clean_r2
    ]
}

comparison_df = pd.DataFrame(comparison)

# Calculate percentage change
comparison_df["Percentage Change"] = (
    (comparison_df["Cleaned Model"] - comparison_df["Baseline Model"])
    / comparison_df["Baseline Model"]
) * 100

